+class _V5Rebaser(_V3Rebaser):
+	"""Rebaser for slide info version 5 (macOS 15+ shared caches).
+
+	The v5 ``dyld_cache_slide_info`` header is laid out exactly like v3
+	(version, page_size, page_starts_count, u64, page_starts[]), and the
+	NO_REBASE page attribute is the same 0xFFFF, so only the in-page pointer
+	encoding differs.  Semantics taken from dyld's
+	mach_o/ChainedFixups.cpp PointerFormat_DYLD_CHAINED_PTR_ARM64E_SHARED_CACHE:
+
+	    auth    -> target = runtimeOffset (+ slideInfo.value_add)
+	    regular -> target = (high8 << 56) | runtimeOffset
+	"""
+
+	def _rebasePage(
+		self,
+		ctx: MachOContext,
+		pageOffset: int,
+		delta: int
+	) -> None:
+		locOff = pageOffset
 
+		while True:
+			locOff += delta
+			locInfo = dyld_cache_slide_pointer5(self.dyldCtx.file, locOff)
+
+			# 8-byte stride; same bit position in both union variants
+			delta = locInfo.regular.next * 8
+
+			# Mirrors dyld's own in-process v5 walk, SharedCacheRuntime.cpp:
+			#   uint64_t target = slideHeader->value_add
+			#                   + loc->regular.runtimeOffset + results->slide;
+			#   if ( loc->auth.auth ) loc->raw = signPointer(loc, target);
+			#   else                  loc->raw = target | ptr.cache64e.high8();
+			# The auth variant is stored unsigned here on purpose: the auth
+			# metadata (key/diversity/addrDiv) is re-emitted separately by the
+			# chained-fixups converter, exactly as _V3Rebaser does.
+			target = self.slideInfo.value_add + locInfo.regular.runtimeOffset
+			if locInfo.auth.auth:
+				newValue = target
+			else:
+				newValue = target | (locInfo.regular.high8 << 56)
+
 			ctx.writeBytes(locOff, struct.pack("<Q", newValue))
 
 			if delta == 0:
@@ -283,7 +337,7 @@
 		slideInfoVer = dyldCtx.readFormat("<I", slideInfoOff)[0]
 
 		if slideInfoVer not in _SlideInfoMap:
-			logger.error("Unknown slide info version: " + slideInfoVer)
+			logger.error("Unknown slide info version: " + str(slideInfoVer))
