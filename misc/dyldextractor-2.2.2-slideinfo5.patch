# dyldextractor 2.2.2: add slide info v5 (macOS 15+ shared caches) support
#
#   - dyld_structs.py : dyld_cache_slide_info5 + dyld_chained_ptr_arm64e_shared_cache_{rebase,auth_rebase}
#   - slide_info.py   : _SlideInfoMap[5] + _V5Rebaser, and a logging fix (int vs str)
#
# Algorithm mirrors dyld's own in-process walk: dyld/SharedCacheRuntime.cpp:767-792
# and include/mach-o/dyld_cache_format.h:515-530.
#
# Apply with:  patch -p1 -d <site-packages> < this-file

--- a/DyldExtractor/dyld/dyld_structs.py
+++ b/DyldExtractor/dyld/dyld_structs.py
@@ -318,8 +318,94 @@
 			("raw", c_uint64),
 			("plain", _plain),
 			("auth", _auth),
+		]
+
+		def __new__(cls, dataSource: bytes, offset=0):
+			if dataSource:
+				instance = None
+				if memoryview(dataSource).readonly:
+					instance = cls.from_buffer_copy(dataSource, offset)
+				else:
+					instance = cls.from_buffer(dataSource, offset)
+
+				instance._fileOff_ = offset
+				return instance
+			else:
+				super().__new__(cls)
+
+		def __init__(self, dataSource: bytes, offset=0) -> None:
+			pass
+
+		def __len__(self) -> int:
+			return sizeof(self)
+
+else:
+	raise NotImplementedError("Unable use a union on a big endian system!")
+
+
+class dyld_cache_slide_info5(Structure):
+
+	version: int 			# currently 5
+	page_size: int 			# currently 4096 (may also be 16384)
+	page_starts_count: int
+	value_add: int
+	# uint16_t    page_starts[/* page_starts_count */]
+
+	_fields_ = [
+		("version", c_uint32),
+		("page_size", c_uint32),
+		("page_starts_count", c_uint32),
+		("value_add", c_uint64),
+	]
+
+
+if sys.byteorder == "little":
+	class _regular5(Structure):
+		runtimeOffset: int 	# offset from the start of the shared cache
+		high8: int
+		unused: int
+		next: int 			# 8-byte stride
+		auth: int 			# == 0
+
+		_fields_ = [
+			("runtimeOffset", c_uint64, 34),
+			("high8", c_uint64, 8),
+			("unused", c_uint64, 10),
+			("next", c_uint64, 11),
+			("auth", c_uint64, 1),
 		]
 
+	class _auth5(Structure):
+		runtimeOffset: int 	# offset from the start of the shared cache
+		diversity: int
+		addrDiv: int
+		keyIsData: int 		# 0 -> IA key, 1 -> DA key
+		next: int 			# 8-byte stride
+		auth: int 			# == 1
+
+		_fields_ = [
+			("runtimeOffset", c_uint64, 34),
+			("diversity", c_uint64, 16),
+			("addrDiv", c_uint64, 1),
+			("keyIsData", c_uint64, 1),
+			("next", c_uint64, 11),
+			("auth", c_uint64, 1),
+		]
+
+	class dyld_cache_slide_pointer5(Union):
+
+		_fileOff_: int
+
+		raw: int
+		regular: _regular5
+		auth: _auth5
+
+		_fields_ = [
+			("raw", c_uint64),
+			("regular", _regular5),
+			("auth", _auth5),
+		]
+
 		def __new__(cls, dataSource: bytes, offset=0):
 			if dataSource:
 				instance = None
