+def check_general(bundle,repair=False):
+ b=Path(bundle);ident='com.apple.systempreferences.GeneralSettings'
+ info=plistlib.loads((b/'Contents/Info.plist').read_bytes())
+ if info.get('CFBundleIdentifier')!=ident:return
+ if b.resolve()!=(ROOT/'System/Applications/System Settings.app/Contents/PlugIns/GeneralSettings.appex').resolve():raise ValueError('unqualified General path')
+ p=b/'Contents/MacOS/GeneralSettings';st=p.lstat()
+ if not stat.S_ISREG(st.st_mode) or st.st_uid or st.st_mode&0o022:raise ValueError('unowned General image')
+ before=code_identity(p.read_bytes())
+ code=[{k:v for k,v in x.items() if k!='entitlements'} for x in before]
+ if hashlib.sha256(json.dumps(code,sort_keys=True).encode()).hexdigest()!='4cdfa8b6e54a8436fd24749a6c44b264211a5f45bdbdce97cf53fb991b1114e6':raise ValueError('General code/UUID/dependencies differ from measured 24G90 image')
+ rights=[x['entitlements'] for x in before]
+ if all(x.get(RIGHT) is True for x in rights):return
+ if not repair:raise ValueError('General missing measured WindowManagement cross-UID query right')
+ if not all(x==rights[0] for x in rights):raise ValueError('General per-slice rights differ')
+ rights=dict(rights[0]);rights[RIGHT]=True
+ db=ROOT/'private/var/db/macws/settings-runtime/pane-rights';db.mkdir(parents=True,exist_ok=True)
+ work=Path(tempfile.mkdtemp(prefix='general-',dir=db));os.chmod(work,0o700)
+ shutil.copy2(p,work/'main.before');(work/'rights.plist').write_bytes(plistlib.dumps(rights))
+ (work/'records.json').write_text(json.dumps({'path':str(p),'before_sha256':digest(p),'right':RIGHT,'code_pin':'4cdfa8b6e54a8436fd24749a6c44b264211a5f45bdbdce97cf53fb991b1114e6'},indent=2)+'\n')
+ candidate=p.with_name('.GeneralSettings.rights-new');assert not candidate.exists()
+ try:
+  shutil.copy2(p,candidate)
+  for _ in range(2):run('/var/jb/usr/bin/ldid','-I'+ident,'-S'+str(work/'rights.plist'),str(candidate))
+  after=code_identity(candidate.read_bytes())
+  if len(after)!=len(before):raise ValueError('General architecture count changed')
+  for x,y in zip(before,after):
+   if {k:v for k,v in x.items() if k!='entitlements'}!={k:v for k,v in y.items() if k!='entitlements'} or y['entitlements']!=rights:raise ValueError('General unrequested code/dependency/right change')
+  hashes=re.findall(r'^CDHash=(\w+)',run('/var/jb/usr/bin/ldid','-h',str(candidate)),re.M)
+  if not hashes:raise ValueError('General no code hash')
+  for h in hashes:run('/var/jb/usr/bin/jbctl','trustcache','add',h)
+  os.chown(candidate,st.st_uid,st.st_gid);os.chmod(candidate,stat.S_IMODE(st.st_mode));os.replace(candidate,p)
+  (work/'after.json').write_text(json.dumps({'sha256':digest(p),'cdhashes':hashes},indent=2)+'\n')
+ finally:
+  if candidate.exists():candidate.unlink()
+ print('SETTINGS-RIGHTS General measured cross-UID WindowManagement right added; code/dependencies preserved; rollback='+str(work))
+ check_general(b,False)
