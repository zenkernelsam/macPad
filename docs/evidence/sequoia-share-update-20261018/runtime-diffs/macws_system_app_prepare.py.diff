 def prepare_locked(executable, plugins, state):
     converted = ensure_main_profile(executable, state)
     paths = [executable] + ([plugins] if os.path.isdir(plugins) else [])
+    # The shared app wire adapter is an injected runtime dependency. Its
+    # signed CodeDirectories must regain live trust after each jailbreak.
+    with open(ROOT + '/System/Library/CoreServices/SystemVersion.plist', 'rb') as version_file:
+        version = plistlib.load(version_file).get('ProductVersion')
+    if version == '15.6.1':
+        adapter = ROOT + '/usr/local/lib/AppRBSWire15.dylib'
+        st = os.lstat(adapter)
+        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
+            raise ValueError('unsafe shared application wire adapter')
+        paths.append(adapter)
+        activity = (ROOT + '/System/Applications/Utilities/'
+                    'Activity Monitor.app/Contents/MacOS/Activity Monitor')
+        if executable == activity:
+            scope = ROOT + '/usr/local/lib/ActivityProcessScope15.dylib'
+            st = os.lstat(scope)
+            if (not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or
+                    st.st_mode & 0o022):
+                raise ValueError('unsafe Activity Monitor process scope adapter')
+            paths.append(scope)
+
     paths = [os.path.realpath(path) for path in paths]
     manifest = os.path.join(state, 'hashes.json')
     dependency_manifest = os.path.join(state, 'dependencies.json')
