+    g14EventOriginal = (void *)method_getImplementation(method);
+    if (!class_addMethod(cls, sel, (IMP)g14Event, method_getTypeEncoding(method)))
+        method_setImplementation(class_getInstanceMethod(cls, sel), (IMP)g14Event);
+}
