+typedef void (^MacWSANEExistsMacReply)(BOOL, NSString *, NSError *);
+static void (*MacWSANEOriginalExists)(id,SEL,id,MacWSANEExistsMacReply);
+static void MacWSANEExists(id connection,SEL selector,id model,MacWSANEExistsMacReply reply) {
+    NSXPCConnection *daemon=MacWSANEDaemonConnection(connection);
+    if(!daemon){MacWSANEOriginalExists(connection,selector,model,reply);return;}
+    id<MacWSANEDaemonIOSWire> proxy=[daemon synchronousRemoteObjectProxyWithErrorHandler:^(NSError *error){
+        MacWSANELog(@"exists transport error=%@",error);
+        if(reply)reply(NO,nil,error);
+    }];
+    [proxy compiledModelExistsFor:model withReply:^(BOOL exists,NSError *error){
+        // iOS16 supplies no cache-URL string. Preserve that absence, along
+        // with the actual daemon boolean/error, rather than inventing a URL.
+        MacWSANELog(@"exists daemon reply exists=%d error=%@",exists,error);
+        if(reply)reply(exists,nil,error);
+    }];
+}
+static BOOL MacWSANEInstallSequoiaExists(void) {
+    static BOOL installed; static dispatch_once_t once;
+    dispatch_once(&once,^{
