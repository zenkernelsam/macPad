+        if(m && !strcmp(method_getTypeEncoding(m),"v32@0:8@16@?24")) {
+            MacWSANEOriginalExists=(void*)method_setImplementation(m,(IMP)MacWSANEExists);
+            installed=MacWSANEOriginalExists!=NULL;
+        }
+    });return installed;
+}
